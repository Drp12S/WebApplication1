@model IEnumerable<WebApplication1.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int stt = 1; 
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2 style="margin: 0; color: #333; font-weight: bold;">Danh sách danh mục sản phẩm</h2>
    @Html.ActionLink("+ Thêm danh mục mới", "Create", null, new { @class = "btn btn-success", @style = "font-weight: bold;" })
</div>

<table class="table table-bordered table-hover table-striped" style="box-shadow: 0 2px 5px rgba(0,0,0,0.05); background-color: #fff;">
    <thead style="background-color: #343a40; color: #ffffff;">
        <tr>
            <th style="width: 80px; text-align: center;">STT</th>
            <th>Tên danh mục</th>
            <th style="width: 250px; text-align: center;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="3" class="text-center" style="padding: 30px; color: #888;">
                    <em>Hiện chưa có danh mục nào. Hãy bấm nút <b>"+ Thêm danh mục mới"</b> ở trên để tạo nhé!</em>
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td style="text-align: center; vertical-align: middle; font-weight: bold; color: #666;">
                        @(stt++)
                    </td>
                    <td style="vertical-align: middle; font-size: 15px;">
                        @Html.DisplayFor(modelItem => item.CategoryName)
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-warning btn-sm", @style = "margin-right: 4px;" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info btn-sm", @style = "margin-right: 4px;" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
