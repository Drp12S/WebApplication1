@model WebApplication1.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div style="max-width: 700px;">
    <h2 style="color: #333; font-weight: bold; margin-bottom: 20px;">Xóa sản phẩm</h2>

    <div style="background-color: #fff; padding: 25px; border-radius: 6px; border: 1px solid #ddd; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">

        <!--Hộp cảnh báo đỏ nhạt-->
        <div style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 12px 15px; border-radius: 4px; margin-bottom: 20px;">
            <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác!
        </div>

        <!--Khung tóm tắt sản phẩm sắp xóa-->
        <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 20px; padding: 15px; background-color: #fcfcfc; border: 1px solid #eee; border-radius: 4px;">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <img src="@Url.Content(Model.ProductImage)" alt="@Model.ProductName" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid #ccc;" />
            }
            else
            {
                <div style="width: 80px; height: 80px; background-color: #eee; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #888; text-align: center;">
                    (Không ảnh)
                </div>
            }

            <div>
                <div style="font-size: 18px; font-weight: bold; color: #333; margin-bottom: 5px;">
                    @Html.DisplayFor(model => model.ProductName)
                </div>
                <div style="color: #666; font-size: 13px; margin-bottom: 5px;">
                    Danh mục: <strong>@(Model.Category != null ? Model.Category.CategoryName : "Chưa phân loại")</strong>
                </div>
                <div style="color: #d9534f; font-weight: bold; font-size: 16px;">
                    @string.Format("{0:N0} đ", Model.ProductPrice)
                </div>
            </div>
        </div>

        <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;" />

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div style="display: flex; gap: 10px; align-items: center;">
                <!--Nút Xóa-->
                <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" style="font-weight: bold; padding: 6px 20px;" />

                <!--Nút Quay lại-->
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn", @style = "background-color: #cce5ff; border: 1px solid #b8daff; color: #000; font-weight: 500; padding: 6px 16px;" })
            </div>
        }
    </div>
</div>
