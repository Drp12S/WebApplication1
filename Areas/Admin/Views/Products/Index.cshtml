@model WebApplication1.Models.ViewModel.ProductSearchViewModel

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .search-container, .order-container {
        padding-top: 10px;
        padding-bottom: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .search-container .form-control {
            border: 1px solid #000000;
        }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
    <h2 style="margin: 0; color: #333; font-weight: bold;">Danh sách sản phẩm</h2>
    @Html.ActionLink("+ Thêm sản phẩm mới", "Create", null, new { @class = "btn btn-success", @style = "font-weight: bold;" })
</div>

@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="form-group search-container">
        @Html.TextBoxFor(m => m.SearchTerm, new
        {
            @class = "form-control",
            placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm",
            style = "width: 320px;"
        })

        @Html.TextBoxFor(m => m.MinPrice, new
        {
            @class = "form-control",
            placeholder = "Nhập giá tối thiểu",
            type = "number",
            style = "width: 170px;"
        })

        @Html.TextBoxFor(m => m.MaxPrice, new
        {
            @class = "form-control",
            placeholder = "Nhập giá tối đa",
            type = "number",
            style = "width: 170px;"
        })

        <button type="submit" class="btn btn-primary" style="font-weight: bold;">Tìm kiếm</button>

        @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
        {
            <a href="@Url.Action("Index", "Products")" class="btn btn-default" style="border: 1px solid #000000; background: #fff;">Xóa lọc</a>
        }
    </div>
}

@Html.Partial("PaView_ListPro", Model)